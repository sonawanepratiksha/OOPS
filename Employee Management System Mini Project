#include <iostream>
#include <vector>
#include <string>
#include <algorithm>
#include <iomanip>
#include <fstream>

using namespace std;

// Utility for styling
void printLine(const string& msg) {
    cout << "--------------------------------------------------------" << endl;
    cout << msg << endl;
    cout << "--------------------------------------------------------" << endl;
}

// Base Class: Employee
class Employee {
protected:
    int id;
    string name;
    string department;
    double salary;

public:
    virtual void inputDetails() = 0;   // Abstract method for input
    virtual void displayDetails() const = 0; // Abstract method for display
    virtual ~Employee() = default;    // Virtual destructor for cleanup

    int getID() const { return id; }
    string getDepartment() const { return department; }
    string getName() const { return name; }  // Getter method for name
    virtual double calculateSalary() const { return salary; }
};

// Derived Class: Manager
class Manager : public Employee {
    double bonus;

public:
    void inputDetails() override {
        cout << "👨‍💼 Enter Manager ID: ";
        cin >> id;
        cout << "👤 Enter Name: ";
        cin.ignore();
        getline(cin, name);
        cout << "🏢 Enter Department: ";
        getline(cin, department);
        cout << "💰 Enter Base Salary: ";
        cin >> salary;
        cout << "🎁 Enter Bonus: ";
        cin >> bonus;
    }

    void displayDetails() const override {
        cout << "👤 ID: " << id << " | Name: " << name 
             << " | Dept: " << department << " | Salary: ₹" 
             << fixed << setprecision(2) << calculateSalary() << endl;
    }

    double calculateSalary() const override {
        return salary + bonus;
    }
};

// Derived Class: Developer
class Developer : public Employee {
    int projects;

public:
    void inputDetails() override {
        cout << "👨‍💻 Enter Developer ID: ";
        cin >> id;
        cout << "👤 Enter Name: ";
        cin.ignore();
        getline(cin, name);
        cout << "🏢 Enter Department: ";
        getline(cin, department);
        cout << "💰 Enter Base Salary: ";
        cin >> salary;
        cout << "🛠 Enter Number of Projects: ";
        cin >> projects;
    }

    void displayDetails() const override {
        cout << "👤 ID: " << id << " | Name: " << name 
             << " | Dept: " << department << " | Salary: ₹" 
             << fixed << setprecision(2) << calculateSalary() << endl;
    }

    double calculateSalary() const override {
        return salary + (projects * 1000);
    }
};

// Derived Class: Intern
class Intern : public Employee {
    int months;

public:
    void inputDetails() override {
        cout << "🎓 Enter Intern ID: ";
        cin >> id;
        cout << "👤 Enter Name: ";
        cin.ignore();
        getline(cin, name);
        cout << "🏢 Enter Department: ";
        getline(cin, department);
        cout << "💰 Enter Stipend: ";
        cin >> salary;
        cout << "🗓 Enter Duration (Months): ";
        cin >> months;
    }

    void displayDetails() const override {
        cout << "👤 ID: " << id << " | Name: " << name 
             << " | Dept: " << department << " | Stipend: ₹" 
             << fixed << setprecision(2) << calculateSalary() << endl;
    }

    double calculateSalary() const override {
        return salary * months;
    }
};

// Main Management System
class EmployeeManagement {
    vector<Employee*> employees;

public:
    ~EmployeeManagement() {
        for (auto emp : employees) delete emp; // Cleanup dynamically allocated memory
    }

    void addEmployee() {
        cout << "Select Employee Type:\n1. Manager\n2. Developer\n3. Intern\nEnter Choice: ";
        int choice;
        cin >> choice;
        Employee* emp = nullptr;

        switch (choice) {
            case 1: emp = new Manager(); break;
            case 2: emp = new Developer(); break;
            case 3: emp = new Intern(); break;
            default: cout << "❌ Invalid Choice!" << endl; return;
        }

        emp->inputDetails();
        employees.push_back(emp);
        cout << "✅ Employee Added Successfully!" << endl;
    }

    void updateEmployee() {
        int id;
        cout << "🔄 Enter Employee ID to Update: ";
        cin >> id;
        for (auto emp : employees) {
            if (emp->getID() == id) {
                emp->inputDetails();
                cout << "✅ Employee Updated Successfully!" << endl;
                return;
            }
        }
        cout << "❌ Employee Not Found!" << endl;
    }

    void removeEmployee() {
        int id;
        cout << "❌ Enter Employee ID to Remove: ";
        cin >> id;
        auto it = remove_if(employees.begin(), employees.end(), [&](Employee* emp) {
            return emp->getID() == id;
        });

        if (it != employees.end()) {
            delete *it;
            employees.erase(it);
            cout << "✅ Employee Removed Successfully!" << endl;
        } else {
            cout << "❌ Employee Not Found!" << endl;
        }
    }

    void displayAllEmployees() {
        printLine("📋 All Employees");
        for (const auto emp : employees) {
            emp->displayDetails();
        }
    }

    void searchEmployeeByID() {
        int id;
        cout << "🔍 Enter Employee ID to Search: ";
        cin >> id;
        for (const auto emp : employees) {
            if (emp->getID() == id) {
                emp->displayDetails();
                return;
            }
        }
        cout << "❌ Employee Not Found!" << endl;
    }

    void displayDepartmentSummary() {
        printLine("📊 Department Summary");
        vector<string> departments;
        for (const auto emp : employees) {
            departments.push_back(emp->getDepartment());
        }

        sort(departments.begin(), departments.end());
        departments.erase(unique(departments.begin(), departments.end()), departments.end());

        for (const auto& dept : departments) {
            int count = count_if(employees.begin(), employees.end(), [&](Employee* emp) {
                return emp->getDepartment() == dept;
            });
            cout << dept << ": " << count << " Employees" << endl;
        }
    }

    void generateSalarySlip() {
        int id;
        cout << "💳 Enter Employee ID for Salary Slip: ";
        cin >> id;
        for (const auto emp : employees) {
            if (emp->getID() == id) {
                cout << "💳 Salary Slip for Employee " << id << ": ₹" 
                     << fixed << setprecision(2) << emp->calculateSalary() << endl;
                return;
            }
        }
        cout << "❌ Employee Not Found!" << endl;
    }

    void saveToFile() {
        ofstream outFile("employee_data.txt");
        if (outFile.is_open()) {
            outFile << "📋 Employee Data\n";
            outFile << "--------------------------------------------------------\n";

            for (const auto emp : employees) {
                outFile << "ID: " << emp->getID()
                        << " | Name: " << emp->getName()  // Use the getter for name
                        << " | Dept: " << emp->getDepartment()
                        << " | Salary: ₹" << fixed << setprecision(2) << emp->calculateSalary()
                        << "\n";
            }

            outFile << "--------------------------------------------------------\n";
            outFile.close();
            cout << "✅ Data Saved to File: employee_data.txt" << endl;
        } else {
            cout << "❌ Unable to Open File!" << endl;
        }
    }

    void showMenu() {
        while (true) {
            printLine("🏢 Employee Management System");
            cout << "1. Add Employee\n2. Update Employee\n3. Remove Employee\n4. Display All Employees\n";
            cout << "5. Search Employee by ID\n6. Department Summary\n";
            cout << "7. Generate Salary Slip\n8. Save to File\n9. Exit\n";
            cout << "Enter Choice: ";
            int choice;
            cin >> choice;

            switch (choice) {
                case 1: addEmployee(); break;
                case 2: updateEmployee(); break;
                case 3: removeEmployee(); break;
                case 4: displayAllEmployees(); break;
                case 5: searchEmployeeByID(); break;
                case 6: displayDepartmentSummary(); break;
                case 7: generateSalarySlip(); break;
                case 8: saveToFile(); break;
                case 9: return;
                default: cout << "❌ Invalid Choice!" << endl;
            }
        }
    }
};

// Main Function
int main() {
    EmployeeManagement em;
    em.showMenu();
    return 0;
}
